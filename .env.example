# Smart Krishi - copy to .env and edit. Same settings as Campus Mithra's .env,
# plus the Krishi-specific ones at the bottom.

# --- Gemma -------------------------------------------------------------------
# gemini = Gemma via Google AI Studio (nothing to install); ollama = local, offline
LLM_BACKEND=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemma-4-26b-a4b-it
GEMINI_FALLBACK_MODEL=gemma-4-31b-it
GEMINI_THINKING=minimal
OLLAMA_URL=http://localhost:11434
GEMMA_MODEL=gemma3:4b

# --- RAG embeddings (empty EMBED_MODEL = TF-IDF keyword matching only) ----------
EMBED_MODEL=gemini-embedding-001
# Relevance gates: a question below both is answered "not enough verified information".
EMB_MIN_SCORE=0.67
TFIDF_MIN_SCORE=0.11

# --- Speech to text (sarvam recommended for Kannada) ---------------------------
STT_PROVIDER=sarvam
SARVAM_API_KEY=
SARVAM_MODEL=saaras:v4
SARVAM_LANGUAGE=unknown    # auto-detect Kannada / English; or fix it: kn-IN, en-IN
WHISPER_MODEL=base.en
STT_LANGUAGE=en

# --- Text to speech (edge-tts, needs internet) ---------------------------------
TTS_VOICE=en-IN-NeerjaNeural
TTS_VOICE_KN=kn-IN-SapnaNeural
TTS_VOICE_HI=hi-IN-SwaraNeural
TTS_ENABLED=1
SPEAK_SOURCES=0
# Reply languages: questions in these are answered in them; others in English.
KIOSK_LANGUAGES=en,kn,hi
# Must equal PLAY_RATE in firmware/include/config.h (MAX98357A).
ESP_I2S_RATE=16000
# Kiosk speaker loudness: soft-limiter drive for the MAX98357A audio. 0 = Campus Mithra's
# level, 6 = about +3 dB, 8 = about +4 dB (more compressed). Restart the server after changing.
KIOSK_LOUDNESS=2
# Kiosk speaker volume 0-100 (sent at connect). 70 = clear and not too loud.
KIOSK_VOLUME=70
# Cut the low frequencies a small speaker cannot play (Hz, 0 = off).
KIOSK_HIGHPASS_HZ=180
# edge-tts speaking rate, e.g. -8% = a little slower and clearer.
TTS_RATE=-8%
ESP_PLAY_RATE=8000

# --- Server ------------------------------------------------------------------
HOST=0.0.0.0
# 8001 so Smart Krishi and Campus Mithra (8000) can run side by side.
PORT=8001
# krishi_client.py talks to this server (default http://127.0.0.1:$PORT)
# KRISHI_SERVER=http://127.0.0.1:8001

# --- Smart Krishi -------------------------------------------------------------
# Knowledge base folder (default ./kb). Never point this at Campus Mithra's kb/.
# KRISHI_KB_DIR=
# Device token the UNO Q sensor app must send (Authorization: Bearer <token>).
# Empty = sensor ingestion switched off. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
KRISHI_SENSOR_TOKEN=
# A sensor that has not reported for this many seconds is "stale", then "offline".
SENSOR_STALE_S=30
SENSOR_OFFLINE_S=120
# District of the farm land, for assumed soil nutrient status when there is no
# Soil Health Card value: bengaluru, tumakuru, kolar, hassan, belagavi,
# chikkaballapura or other (= general dose). The touch screen can change it.
KRISHI_REGION=bengaluru

# Free key from https://data.gov.in (My Account -> Generate API key). Used for today's crop
# market (mandi) prices from AGMARKNET when farmers ask "what is the rate of tomato?", and for
# real farmer questions in the evaluation (eval/fetch_kcc.py).
DATA_GOV_IN_API_KEY=
# KRISHI_STATE=Karnataka        # state whose mandis are searched first (then all India)
# PRICE_CACHE_S=1800            # how long a price lookup is reused
