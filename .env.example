# Smart Krishi - copy to .env and edit. Same settings as Campus Mithra's .env,
# plus the Krishi-specific ones at the bottom.

# --- Gemma -------------------------------------------------------------------
# gemini = Gemma via Google AI Studio (nothing to install); ollama = local, offline
LLM_BACKEND=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemma-4-26b-a4b-it
GEMINI_FALLBACK_MODEL=gemma-4-31b-it
GEMINI_THINKING=minimal
OLLAMA_URL=http://localhost:11434
GEMMA_MODEL=gemma3:4b

# --- RAG embeddings (empty EMBED_MODEL = TF-IDF keyword matching only) ----------
EMBED_MODEL=gemini-embedding-001
# Relevance gates: a question below both is answered "not enough verified information".
EMB_MIN_SCORE=0.62
TFIDF_MIN_SCORE=0.10

# --- Speech to text (sarvam recommended for Kannada) ---------------------------
STT_PROVIDER=sarvam
SARVAM_API_KEY=
SARVAM_MODEL=saaras:v4
SARVAM_LANGUAGE=unknown    # auto-detect Kannada / English; or fix it: kn-IN, en-IN
WHISPER_MODEL=base.en
STT_LANGUAGE=en

# --- Text to speech (edge-tts, needs internet) ---------------------------------
TTS_VOICE=en-IN-NeerjaNeural
TTS_VOICE_KN=kn-IN-SapnaNeural
TTS_ENABLED=1
SPEAK_SOURCES=1
# Reply languages: questions in these are answered in them; others in English.
KIOSK_LANGUAGES=en,kn
# Must equal PLAY_RATE in firmware/include/config.h (MAX98357A).
ESP_I2S_RATE=16000
ESP_PLAY_RATE=8000

# --- Server ------------------------------------------------------------------
HOST=0.0.0.0
# 8001 so Smart Krishi and Campus Mithra (8000) can run side by side.
PORT=8001
# krishi_client.py talks to this server (default http://127.0.0.1:$PORT)
# KRISHI_SERVER=http://127.0.0.1:8001

# --- Smart Krishi -------------------------------------------------------------
# Knowledge base folder (default ./kb). Never point this at Campus Mithra's kb/.
# KRISHI_KB_DIR=
# 1 = use a clearly labelled MOCK soil reading until a real sensor posts one.
SOIL_MOCK=1
# Readings older than this many minutes are flagged STALE to Gemma.
SOIL_MAX_AGE_MIN=60
# If set, the soil sensor ESP32 must send it as the X-Device-Key header.
KRISHI_SENSOR_KEY=
